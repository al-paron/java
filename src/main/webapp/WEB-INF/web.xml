<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Farm Market</display-name>

    <!-- Кодировка по умолчанию -->
    <filter>
        <filter-name>encodingFilter</filter-name>
        <filter-class>org.web.filters.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>

    <filter-mapping>
        <filter-name>encodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Сервлет для главной страницы -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>org.web.HomeServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/home</url-pattern>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <!-- Сервлет для регистрации -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>org.web.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Сервлет для входа -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>org.web.LoginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Сервлет для выхода -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>org.web.LogoutServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Сервлет для товаров -->
    <servlet>
        <servlet-name>ProductsServlet</servlet-name>
        <servlet-class>org.web.ProductsServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ProductsServlet</servlet-name>
        <url-pattern>/products</url-pattern>
    </servlet-mapping>

    <!-- JSP конфигурация -->
    <jsp-config>
        <taglib>
            <taglib-uri>http://java.sun.com/jsp/jstl/core</taglib-uri>
            <taglib-location>/WEB-INF/lib/jstl.jar</taglib-location>
        </taglib>
    </jsp-config>

    <!-- Сессии: 30 минут -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Страницы ошибок -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>

    <!-- Приветственная страница -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

</web-app>